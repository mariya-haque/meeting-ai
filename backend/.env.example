# ------------------------------------------------------------------
# Copy this file to `.env` and fill in the values.
# ------------------------------------------------------------------

# App
APP_NAME=Personal AI Meeting Assistant
FRONTEND_URL=http://localhost:5173

# Database
# SQLite (default, zero-config for local dev):
DATABASE_URL=sqlite:///./meeting_ai.db
# PostgreSQL (production) — uncomment and set your own:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/meeting_ai

# JWT
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth 2.0 + Calendar
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
